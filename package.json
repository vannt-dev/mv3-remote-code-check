{
  "name": "mv3-remote-code-check",
  "version": "0.2.0",
  "description": "Reads a built browser extension the way the Chrome Web Store review does and fails on remotely hosted code (Manifest V3), as a CLI, a GitHub Action and a Vite plugin.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "mv3",
    "chrome-web-store",
    "remote-code",
    "browser-extension",
    "vite-plugin",
    "github-action"
  ],
  "homepage": "https://github.com/vannt-dev/mv3-remote-code-check#readme",
  "bugs": {
    "url": "https://github.com/vannt-dev/mv3-remote-code-check/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vannt-dev/mv3-remote-code-check.git"
  },
  "license": "MIT",
  "author": "Van Nguyen",
  "type": "module",
  "bin": {
    "mv3-remote-code-check": "bin/mv3-remote-code-check.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "npm run build && node --test \"test/*.test.ts\"",
    "lint": "eslint . && tsc --noEmit && prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
